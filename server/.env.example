PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=finantrack
# Cambia este valor por una cadena larga y aleatoria
JWT_SECRET=cambia-esto-por-un-secreto-largo
UPLOAD_DIR=uploads
CORS_ORIGIN=http://localhost:5173
# Detrás de un proxy (Railway): TRUST_PROXY=1. En desarrollo déjalo sin definir.
# TRUST_PROXY=1
# Web Push: genera las claves con  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Zona horaria del resumen semanal de los lunes
APP_TIMEZONE=America/Bogota
